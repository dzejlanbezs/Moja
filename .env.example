# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored, so your keys never end up on GitHub.

# Your public site address. Used for the payment provider's callback and for the
# link inside push notifications, so it must be the real domain in production.
SITE_URL=https://www.theaurea.app

# Pushover notifications — get both values from https://pushover.net
# Leave them empty to turn notifications off.
PUSHOVER_TOKEN=
PUSHOVER_USER=

# PayGate.to — card (Banxa) and PayPal checkout.
# PAYGATE_ADDRESS is the USDC (Polygon) wallet that receives the payouts.
# PAYGATE_EMAIL is the contact email passed to the provider with every payment.
PAYGATE_ADDRESS=0x020c6b1c7adc49e629a1fcb2133a714ad29ce1a2
PAYGATE_EMAIL=infektorr234@gmail.com

# TrafficJunky conversion tracking. A conversion is counted the first time a
# visitor opens a chat with any profile — once per chat, never on a reload.
# Clear TRAFFICJUNKY_AD_ID to switch tracking off.
TRAFFICJUNKY_AD_ID=1000588121
TRAFFICJUNKY_MEMBER_ID=1009196331
TRAFFICJUNKY_VALUE=0.50

# Automatic replies through OpenRouter. The profile can pause them from her
# portal at any time and answer herself, then resume when she is done.
# Leave OPENROUTER_API_KEY empty to switch automatic replies off completely.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=minimax/minimax-m2-her
