# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored, so your keys never end up on GitHub.

# Pushover notifications — get both values from https://pushover.net
# Leave them empty to turn notifications off.
PUSHOVER_TOKEN=
PUSHOVER_USER=

# Optional. When set, every notification links straight to your admin panel.
# Example: https://aurea.com
SITE_URL=
